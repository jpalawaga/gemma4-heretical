#!/usr/bin/env bash
#
# get-gemma4-heretical — Install the balanced uncensored Gemma 4 26B-A4B in Ollama
#
# What this does:
#   Downloads the QAT Q4_K_M GGUF plus its vision projector and registers it
#   as gemma4-heretical with the correct Gemma 4 renderer, parser, context,
#   and sampling parameters.
#
# Source model:
#   HauhauCS/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-MTP
#   - 26B parameter mixture-of-experts model with 4B active parameters
#   - Quantization-aware-trained for Q4_K_M
#   - Balanced uncensoring tuned for reasoning, coding, and conversation
#
# Hugging Face's Ollama manifest includes the separate vision projector. The
# MTP draft head still requires llama.cpp; use get-gemma4-llama and serve-llama
# for speculative decoding.
#
# Requirements:
#   - Ollama 0.30.6+ (https://ollama.com)
#   - ~18 GB disk space for the model and vision projector
#   - A machine with at least ~24 GB available memory
#
# Usage:
#   chmod +x get-gemma4-heretical
#   ./get-gemma4-heretical
#   ollama run gemma4-heretical

set -eu

# Gemma 4 QAT support shipped in Ollama 0.30.6. Earlier releases may inspect
# the GGUF metadata but still fail when the runner tries to load it.
MIN_OLLAMA_VERSION="0.30.6"
if ! command -v ollama &>/dev/null; then
	echo "ERROR: ollama not found. Install it from https://ollama.com" >&2
	exit 1
fi
OLLAMA_VERSION=$(ollama --version 2>&1 | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1)
if [ -z "$OLLAMA_VERSION" ]; then
	echo "ERROR: Could not determine Ollama version." >&2
	exit 1
fi
version_ge() {
	printf '%s\n%s\n' "$2" "$1" | sort -V | head -1 | grep -qx "$2"
}
if ! version_ge "$OLLAMA_VERSION" "$MIN_OLLAMA_VERSION"; then
	echo "ERROR: Ollama ${MIN_OLLAMA_VERSION}+ is required (found ${OLLAMA_VERSION})." >&2
	echo "       Update Ollama: https://ollama.com" >&2
	exit 1
fi

QUANT="Q4_K_M"
HF_REPO="hf.co/HauhauCS/Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-MTP"
MODEL_NAME="gemma4-heretical"

echo "=== gemma4-heretical setup ==="
echo ""
echo "Quantization: ${QUANT}"
echo "Source:       ${HF_REPO}"
echo "Ollama name:  ${MODEL_NAME}"
echo ""

# Step 1: Pull the GGUF from HuggingFace
echo "[1/3] Pulling model and vision projector from HuggingFace (~18 GB)..."
if ! ollama pull "${HF_REPO}:${QUANT}"; then
	echo "ERROR: Failed to pull model. Check your internet connection and that" >&2
	echo "       Ollama is enabled at https://huggingface.co/settings/local-apps" >&2
	exit 1
fi

# Step 2: Copy both FROM layers from the pulled manifest. Ollama currently
# resolves "FROM <model name>" to only the language-model layer during create,
# which silently drops the separately packaged vision projector.
echo ""
echo "[2/3] Creating Modelfile with correct Gemma 4 renderer..."

MODELFILE=$(mktemp)
SOURCE_MODELFILE=$(mktemp)
cleanup() {
	rm -f "$MODELFILE" "$SOURCE_MODELFILE"
}
trap cleanup EXIT

if ! ollama show --modelfile "${HF_REPO}:${QUANT}" > "$SOURCE_MODELFILE"; then
	echo "ERROR: Could not inspect the pulled Ollama manifest." >&2
	exit 1
fi

FROM_LAYERS=$(grep '^FROM ' "$SOURCE_MODELFILE" || true)
FROM_COUNT=$(printf '%s\n' "$FROM_LAYERS" | grep -c '^FROM ' || true)
if [ "$FROM_COUNT" -lt 2 ]; then
	echo "ERROR: Expected language-model and vision-projector layers, found ${FROM_COUNT}." >&2
	echo "       Refusing to create a text-only alias by accident." >&2
	exit 1
fi

cat > "$MODELFILE" <<EOF
# Gemma 4 26B-A4B QAT Balanced Uncensored (${QUANT})
${FROM_LAYERS}
REQUIRES ${MIN_OLLAMA_VERSION}
TEMPLATE {{ .Prompt }}
RENDERER gemma4
PARSER gemma4
PARAMETER top_k 64
PARAMETER top_p 0.9
PARAMETER min_p 0.05
PARAMETER temperature 0.6
PARAMETER repeat_penalty 1.1
PARAMETER num_ctx 16384
EOF

# Step 3: Register the model with the correct metadata
echo "[3/3] Registering as '${MODEL_NAME}'..."
if ! ollama create "${MODEL_NAME}" -f "$MODELFILE"; then
	echo "ERROR: Failed to register ${MODEL_NAME}." >&2
	exit 1
fi
trap - EXIT
cleanup

echo ""
echo "=== Done! ==="
echo ""
echo "Run with:"
echo "  ollama run ${MODEL_NAME}"
echo ""
echo "Model details:"
echo "  Base:        google/gemma-4-26B-A4B-it"
echo "  Variant:     HauhauCS Balanced Uncensored"
echo "  Quant:       ${QUANT} (QAT)"
echo "  Context:     16384"
echo ""
echo "For MTP acceleration through llama.cpp:"
echo "  ./get-gemma4-llama"
echo "  ./serve-llama"
echo "  ./chat --backend llama"
