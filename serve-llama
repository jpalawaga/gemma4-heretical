#!/usr/bin/env bash
#
# Serve a local GGUF model through llama.cpp with vision and MTP enabled.
#
# Usage:
#   ./serve-llama                       # Gemma 4 26B-A4B from ./get-gemma4-llama
#   ./serve-llama --model qwen3.8-27b   # any ./models/NAME directory with a serve.env
#   ./serve-llama --thinking low        # reasoning effort (low|medium|xhigh; Qwen 3.8)
#   ./serve-llama --no-thinking         # disable reasoning for a profile that defaults to it
#   ./serve-llama --mtp | --no-mtp      # force MTP speculative decoding on or off
#   ./serve-llama --no-vision           # text-only, lower memory use
#   ./serve-llama -- --verbose          # pass additional llama-server arguments
#
# Environment:
#   GEMMA4_MODEL_DIR  model directory (default: ./models/gemma4-26b-a4b)
#   GEMMA4_CONTEXT    context length (default: 16384)
#   GEMMA4_PORT       listening port (default: 8082)

set -euo pipefail

PROJECT_DIR="$(cd "$(dirname "$0")" && pwd)"
MODEL_DIR="${GEMMA4_MODEL_DIR:-${PROJECT_DIR}/models/gemma4-26b-a4b}"
CONTEXT="${GEMMA4_CONTEXT:-16384}"
PORT="${GEMMA4_PORT:-8082}"

USE_MTP=1
MTP_SET=0
USE_VISION=1
THINKING=""
THINKING_SET=0
EXTRA_ARGS=()

while [ "$#" -gt 0 ]; do
	case "$1" in
		--model)
			[ "$#" -ge 2 ] || { echo "ERROR: --model needs a name" >&2; exit 2; }
			MODEL_DIR="${PROJECT_DIR}/models/$2"
			shift 2
			;;
		--thinking)
			THINKING="medium"
			THINKING_SET=1
			if [ "$#" -ge 2 ] && [[ "$2" != -* ]]; then
				THINKING="$2"
				shift
			fi
			shift
			;;
		--no-thinking)
			THINKING=""
			THINKING_SET=1
			shift
			;;
		--mtp)
			USE_MTP=1
			MTP_SET=1
			shift
			;;
		--no-mtp)
			USE_MTP=0
			MTP_SET=1
			shift
			;;
		--no-vision)
			USE_VISION=0
			shift
			;;
		--)
			shift
			EXTRA_ARGS+=("$@")
			break
			;;
		-h|--help)
			sed -n '3,18p' "$0" | sed 's/^# \{0,1\}//'
			exit 0
			;;
		*)
			echo "ERROR: Unknown option: $1" >&2
			echo "Use -- to pass options directly to llama-server." >&2
			exit 2
			;;
	esac
done

# Defaults describe the Gemma 4 26B-A4B layout written by ./get-gemma4-llama.
# A serve.env in the model directory overrides any of these.
MODEL_FILE="Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-Q4_K_M.gguf"
MMPROJ_FILE="mmproj-Gemma4-26B-A4B-QAT-Uncensored-HauhauCS-Balanced-BF16.gguf"
MTP_FILE="mtp-gemma-4-26B-A4B-it.gguf"
MTP_EMBEDDED=0
MTP_DEFAULT=1
CHAT_TEMPLATE_FILE=""
ALIAS="gemma4-heretical"
THINKING_KWARGS=0
THINKING_DEFAULT=""
SAMPLING=(--temperature 0.6 --top-k 64 --top-p 0.9 --min-p 0.05 --repeat-penalty 1.1)
THINKING_SAMPLING=()
PROFILE_ARGS=()

if [ -f "${MODEL_DIR}/serve.env" ]; then
	# shellcheck disable=SC1091
	source "${MODEL_DIR}/serve.env"
fi
if [ "$MTP_SET" -eq 0 ]; then
	USE_MTP="$MTP_DEFAULT"
fi
if [ "$THINKING_SET" -eq 0 ]; then
	THINKING="$THINKING_DEFAULT"
fi

if ! command -v llama-server >/dev/null 2>&1; then
	echo "ERROR: llama-server not found." >&2
	echo "Install llama.cpp first; on macOS: brew install llama.cpp" >&2
	exit 1
fi

if [ ! -f "${MODEL_DIR}/${MODEL_FILE}" ]; then
	echo "ERROR: Main model not found at ${MODEL_DIR}/${MODEL_FILE}" >&2
	echo "Run ./get-gemma4-llama or ./get-qwen38-llama first." >&2
	exit 1
fi

ARGS=(
	-m "${MODEL_DIR}/${MODEL_FILE}"
	--alias "$ALIAS"
	--host 127.0.0.1
	--port "$PORT"
	--cors-origins localhost
	--ctx-size "$CONTEXT"
	--parallel 1
	--gpu-layers 99
	--flash-attn on
	--jinja
)

if [ -n "$CHAT_TEMPLATE_FILE" ]; then
	if [ ! -f "${MODEL_DIR}/${CHAT_TEMPLATE_FILE}" ]; then
		echo "ERROR: Chat template not found at ${MODEL_DIR}/${CHAT_TEMPLATE_FILE}" >&2
		exit 1
	fi
	ARGS+=(--chat-template-file "${MODEL_DIR}/${CHAT_TEMPLATE_FILE}")
fi

if [ "$THINKING_KWARGS" -eq 1 ]; then
	if [ -n "$THINKING" ]; then
		case "$THINKING" in
			low|medium|xhigh) ;;
			*)
				echo "ERROR: --thinking must be low, medium, or xhigh" >&2
				exit 2
				;;
		esac
		ARGS+=(--reasoning on --chat-template-kwargs "{\"reasoning_effort\":\"${THINKING}\"}")
		if [ "${#THINKING_SAMPLING[@]}" -gt 0 ]; then
			SAMPLING=("${THINKING_SAMPLING[@]}")
		fi
	else
		ARGS+=(--reasoning off)
	fi
elif [ -n "$THINKING" ]; then
	echo "NOTE: this model profile has no thinking switch; --thinking ignored." >&2
fi

ARGS+=("${SAMPLING[@]}")
if [ "${#PROFILE_ARGS[@]}" -gt 0 ]; then
	ARGS+=("${PROFILE_ARGS[@]}")
fi

if [ "$USE_VISION" -eq 1 ]; then
	if [ ! -f "${MODEL_DIR}/${MMPROJ_FILE}" ]; then
		echo "ERROR: Vision projector not found at ${MODEL_DIR}/${MMPROJ_FILE}" >&2
		echo "Download it first or use --no-vision." >&2
		exit 1
	fi
	ARGS+=(--mmproj "${MODEL_DIR}/${MMPROJ_FILE}")
fi

if [ "$USE_MTP" -eq 1 ]; then
	if [ "$MTP_EMBEDDED" -eq 1 ]; then
		ARGS+=(--spec-type draft-mtp)
	else
		if [ ! -f "${MODEL_DIR}/${MTP_FILE}" ]; then
			echo "ERROR: MTP draft head not found at ${MODEL_DIR}/${MTP_FILE}" >&2
			echo "Download it first or use --no-mtp." >&2
			exit 1
		fi
		ARGS+=(--model-draft "${MODEL_DIR}/${MTP_FILE}" --spec-type draft-mtp)
	fi
fi

echo "=== llama.cpp server ==="
echo "Model:    ${MODEL_DIR}/${MODEL_FILE}"
echo "Alias:    ${ALIAS}"
echo "Vision:   $([ "$USE_VISION" -eq 1 ] && echo enabled || echo disabled)"
echo "MTP:      $([ "$USE_MTP" -eq 1 ] && echo enabled || echo disabled)"
if [ "$THINKING_KWARGS" -eq 1 ]; then
	echo "Thinking: ${THINKING:-disabled}"
fi
echo "Context:  ${CONTEXT}"
echo "Endpoint: http://127.0.0.1:${PORT}/v1"
echo ""
echo "Connect with: ./chat2  (or ./chat --backend llama)"
echo ""

if [ "${#EXTRA_ARGS[@]}" -gt 0 ]; then
	exec llama-server "${ARGS[@]}" "${EXTRA_ARGS[@]}"
else
	exec llama-server "${ARGS[@]}"
fi
