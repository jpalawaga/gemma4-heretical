#!/usr/bin/env -S uv run --script
# /// script
# dependencies = ["openai"]
# ///
#
# chat — Interactive multimodal, tool-calling chat with gemma4-heretical
#
# Requirements:
#   uv (https://docs.astral.sh/uv/getting-started/installation/)
#
# Usage:
#   ./chat                        # plain chat
#   ./chat memory.md              # inject file as system prompt at session start
#   ./chat --backend llama        # llama.cpp with vision + MTP
#   ./chat --backend llama --image photo.jpg
#   ./chat --heartbeat 60         # send heartbeat every 60 seconds
#   ./chat memory.md --heartbeat 120
#
# Memory:
#   Memories are stored in ~/.gemma4-heretical/memories.jsonl
#   The model can save and search memories via tool calls.
#   All memories are auto-injected into the system prompt at startup.
#
# Heartbeats:
#   When --heartbeat N is set, the chat program sends a periodic [HEARTBEAT]
#   message to the model. The model is instructed to respond with <EOM> if it
#   has nothing to say, or with actual content if it wants to surface something.
#   <EOM> responses are silently filtered; real responses are displayed.

import argparse
import base64
import datetime
import json
import mimetypes
import os
import shlex
import sys
import threading
import time
from pathlib import Path

try:
    from openai import OpenAI
except ImportError:
    print("ERROR: openai package not found. Run: pip install openai", file=sys.stderr)
    sys.exit(1)

client = None
BACKEND = "ollama"
MODEL = "gemma4-heretical"
NUM_CTX = 16384
DATA_DIR = os.path.expanduser("~/.gemma4-heretical")
MEMORIES_PATH = os.path.join(DATA_DIR, "memories.jsonl")
LAST_MESSAGE_PATH = os.path.join(DATA_DIR, "lastmessage.txt")
LAST_RESPONSE_PATH = os.path.join(DATA_DIR, "lastresponse.txt")

BACKEND_DEFAULTS = {
    "ollama": {
        "base_url": "http://127.0.0.1:11434/v1",
        "api_key": "ollama",
    },
    "llama": {
        "base_url": "http://127.0.0.1:8082/v1",
        "api_key": "none",
    },
}

IMAGE_MIME_TYPES = {
    ".bmp": "image/bmp",
    ".gif": "image/gif",
    ".jpeg": "image/jpeg",
    ".jpg": "image/jpeg",
    ".png": "image/png",
    ".tga": "image/x-tga",
}

HEARTBEAT_SYSTEM = """
You will periodically receive [HEARTBEAT] messages. These are automated background signals, not user input.
Only respond to a heartbeat if you have something genuinely useful to surface — a reminder, a follow-up
thought, something time-sensitive, or a reflection on the conversation so far.
If you have nothing meaningful to add, your final response must be exactly: <response-opt-out>
If you do have something to say, your final response must be the message you want to send.
Only your final response is shown to the user — any thinking or reasoning before it is discarded.
""".strip()

# --- Memory ---

def load_memories():
    if not os.path.exists(MEMORIES_PATH):
        return []
    memories = []
    with open(MEMORIES_PATH) as f:
        for line in f:
            line = line.strip()
            if line:
                try:
                    memories.append(json.loads(line))
                except json.JSONDecodeError:
                    pass
    return memories

def save_memory(content, tags=None):
    os.makedirs(os.path.dirname(MEMORIES_PATH), exist_ok=True)
    entry = {
        "timestamp": datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S"),
        "content": content,
        "tags": tags or [],
    }
    with open(MEMORIES_PATH, "a") as f:
        f.write(json.dumps(entry) + "\n")
    return entry

def search_memories(query):
    memories = load_memories()
    if not memories:
        return "No memories stored yet."
    query_lower = query.lower()
    results = [
        m for m in memories
        if query_lower in m["content"].lower()
        or any(query_lower in t.lower() for t in m.get("tags", []))
    ]
    if not results:
        return f"No memories matching '{query}'."
    return "\n".join(
        f"[{m['timestamp']}] {m['content']}" + (f" (tags: {', '.join(m['tags'])})" if m.get("tags") else "")
        for m in results
    )

def search_memories_by_tag(tag):
    memories = load_memories()
    if not memories:
        return "No memories stored yet."
    tag_lower = tag.lower()
    results = [m for m in memories if any(tag_lower == t.lower() for t in m.get("tags", []))]
    if not results:
        return f"No memories tagged '{tag}'."
    return "\n".join(
        f"[{m['timestamp']}] {m['content']}" + (f" (tags: {', '.join(m['tags'])})" if m.get("tags") else "")
        for m in results
    )

def forget_memory(query):
    memories = load_memories()
    kept = [m for m in memories if query.lower() not in m["content"].lower()]
    removed = len(memories) - len(kept)
    if removed:
        with open(MEMORIES_PATH, "w") as f:
            for m in kept:
                f.write(json.dumps(m) + "\n")
    return f"Removed {removed} memory entry(s) matching '{query}'."

def read_file(path):
    if not os.path.exists(path):
        return None
    with open(path) as f:
        return f.read().strip() or None

def write_file(path, content):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as f:
        f.write(content)

def last_exchange_system_block():
    last_msg = read_file(LAST_MESSAGE_PATH)
    last_resp = read_file(LAST_RESPONSE_PATH)
    if not last_msg and not last_resp:
        return None
    lines = ["The following are the last message and response from the previous session:"]
    if last_msg:
        lines.append(f"Last user message:\n{last_msg}")
    if last_resp:
        lines.append(f"Last assistant response:\n{last_resp}")
    return "\n\n".join(lines)

def memories_as_system_block(memories):
    if not memories:
        return None
    lines = ["The following are things you have remembered from past conversations:"]
    for m in memories:
        line = f"- [{m['timestamp']}] {m['content']}"
        if m.get("tags"):
            line += f" (tags: {', '.join(m['tags'])})"
        lines.append(line)
    return "\n".join(lines)

