def handle_tool_call(name, arguments):
    if name == "get_current_time":
        return datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S %Z")
    if name == "save_memory":
        entry = save_memory(arguments.get("content", ""), arguments.get("tags", []))
        return f"Saved: {entry['content']}"
    if name == "search_memories":
        return search_memories(arguments.get("query", ""))
    if name == "forget_memory":
        return forget_memory(arguments.get("query", ""))
    if name == "search_memories_by_tag":
        return search_memories_by_tag(arguments.get("tag", ""))
    if name == "get_last_message":
        return read_file(LAST_MESSAGE_PATH) or "No previous message recorded."
    if name == "get_last_response":
        return read_file(LAST_RESPONSE_PATH) or "No previous response recorded."
    return f"Unknown tool: {name}"

# --- API call (shared by main loop and heartbeat thread) ---

def do_api_call(messages):
    """Make one full API call (including tool call loop). Returns final reply string or None."""
    while True:
        request = {
            "model": MODEL,
            "messages": messages,
            "tools": TOOLS,
        }
        if BACKEND == "ollama":
            request["extra_body"] = {
                "options": {"num_ctx": NUM_CTX},
                "keep_alive": -1,
            }
        response = client.chat.completions.create(
            **request,
        )
        msg = response.choices[0].message
        if msg.tool_calls:
            messages.append(msg)
            for tc in msg.tool_calls:
                args = json.loads(tc.function.arguments or "{}")
                result = handle_tool_call(tc.function.name, args)
                if tc.function.name in ("save_memory", "forget_memory"):
                    print(f"\n(memory: {result})")
                messages.append({
                    "role": "tool",
                    "tool_call_id": tc.id,
                    "content": result,
                })
        else:
            return msg.content or "", response.usage

# --- Heartbeat ---

def heartbeat_worker(messages, lock, interval, stop_event, last_user_message_time):
    while not stop_event.wait(interval):
        now = datetime.datetime.now()
        now_str = now.strftime("%Y-%m-%d %H:%M:%S")
        t = last_user_message_time[0]
        if t is not None:
            delta = int((now - t).total_seconds())
            if delta < 60:
                since = f"{delta}s since last user message"
            elif delta < 3600:
                since = f"{delta // 60}m {delta % 60}s since last user message"
            else:
                since = f"{delta // 3600}h {(delta % 3600) // 60}m since last user message"
        else:
            since = "no user messages yet"
        hb_msg = {"role": "user", "content": f"[HEARTBEAT | {now_str} | {since}]"}
        with lock:
            messages.append(hb_msg)
            try:
                reply, _ = do_api_call(messages)
                # Extract final response — strip any chain-of-thought before it
                final = reply.strip()
                if "Response:" in final:
                    final = final.split("Response:")[-1].strip()
                if "<response-opt-out>" in final or not final:
                    # Remove heartbeat — model had nothing to say
                    # Walk back to remove the hb_msg and any tool messages added
                    while messages and messages[-1].get("role") != "user":
                        messages.pop()
                    if messages and messages[-1].get("content", "").startswith("[HEARTBEAT"):
                        messages.pop()
                else:
                    messages.append({"role": "assistant", "content": final})
                    ts = datetime.datetime.now().strftime("%Y-%m-%d %H:%M:%S")
                    print(f"\n[input interrupted: incoming message | {ts}]\n{final}\n>>> ", end="", flush=True)
            except Exception as e:
                # On error, clean up the heartbeat message
                while messages and messages[-1].get("role") != "user":
                    messages.pop()
                if messages and messages[-1].get("content", "").startswith("[HEARTBEAT"):
                    messages.pop()

# --- Input ---

def read_input():
    """Read input, collecting all buffered lines (e.g. from a paste)."""
    import select
    try:
        first = input(">>> ")
    except (EOFError, KeyboardInterrupt):
        return None
    if first.strip().lower() in ("exit", "quit"):
        return None
    lines = [first]
    # After each line, wait up to 50ms for more data (handles paste arriving
    # in chunks). For normal single-line input this adds imperceptible latency.
    while select.select([sys.stdin], [], [], 0.05)[0]:
        try:
            line = sys.stdin.readline()
        except (EOFError, KeyboardInterrupt):
            break
        if not line:
            break
        lines.append(line.rstrip("\n"))
    return "\n".join(lines).strip()

def resolve_image(path):
    """Validate an image path and return its absolute path."""
    candidate = Path(path).expanduser()
    try:
        candidate = candidate.resolve(strict=True)
    except OSError as e:
        raise ValueError(f"Cannot read image '{path}': {e}") from e
    if not candidate.is_file():
        raise ValueError(f"Image is not a file: {candidate}")
    if candidate.suffix.lower() not in IMAGE_MIME_TYPES:
        supported = ", ".join(sorted(IMAGE_MIME_TYPES))
        raise ValueError(f"Unsupported image type '{candidate.suffix}'. Supported: {supported}")
    return str(candidate)

def image_content_part(path):
    """Encode a local image as an OpenAI-compatible data URL content part."""
    suffix = Path(path).suffix.lower()
    mime_type = IMAGE_MIME_TYPES.get(suffix) or mimetypes.guess_type(path)[0]
    with open(path, "rb") as image_file:
        encoded = base64.b64encode(image_file.read()).decode("ascii")
    return {
        "type": "image_url",
        "image_url": {
            "url": f"data:{mime_type};base64,{encoded}",
        },
    }

def user_message_content(text, image_paths):
    """Create a plain-text or multimodal user message."""
    if not image_paths:
        return text
    content = [{"type": "text", "text": text}]
    content.extend(image_content_part(path) for path in image_paths)
    return content

def handle_local_command(text, pending_images):
    """Handle slash commands. Returns True when the input was consumed."""
    command, separator, argument = text.partition(" ")
    command = command.lower()

    if command == "/image":
        if not separator or not argument.strip():
            print("Usage: /image PATH [PATH ...]\n")
            return True
        try:
            paths = shlex.split(argument)
        except ValueError as e:
            print(f"Invalid image path: {e}\n")
            return True
        if not paths:
            print("Usage: /image PATH [PATH ...]\n")
            return True
        try:
            resolved = [resolve_image(path) for path in paths]
        except ValueError as e:
            print(f"{e}\n")
            return True
        pending_images.extend(resolved)
        for path in resolved:
            print(f"(queued image: {path})")
        print()
        return True

    if command == "/images":
        if pending_images:
            print("Images queued for the next message:")
            for path in pending_images:
                print(f"  {path}")
        else:
            print("No images queued.")
        print()
        return True

    if command == "/clear-images":
        count = len(pending_images)
        pending_images.clear()
        print(f"(cleared {count} queued image(s))\n")
        return True

    if command == "/help":
        print(
            "Commands:\n"
            "  /image PATH [PATH ...]  attach image(s) to the next message\n"
            "  /images                 list queued images\n"
            "  /clear-images           discard queued images\n"
            "  **sys: TEXT             add text to system context\n"
            "  exit                     end the session\n"
        )
        return True

    return False

def wrap_with_envelope(text, last_message_time):
    now = datetime.datetime.now()
    sent_at = now.strftime("%Y-%m-%d %H:%M:%S")
    if last_message_time is not None:
        delta = now - last_message_time
        total_seconds = int(delta.total_seconds())
        if total_seconds < 60:
            since = f"{total_seconds}s after previous message"
        elif total_seconds < 3600:
            since = f"{total_seconds // 60}m {total_seconds % 60}s since last message"
        else:
            since = f"{total_seconds // 3600}h {(total_seconds % 3600) // 60}m since last message"
    else:
        since = "first message"
    return f"[{sent_at} | {since}]\n{text}"

# --- Main ---

def parse_args():
    parser = argparse.ArgumentParser(description="Chat with gemma4-heretical")
    parser.add_argument("system_file", nargs="?", help="File to inject as system prompt")
    parser.add_argument(
        "--backend",
        choices=sorted(BACKEND_DEFAULTS),
        default=os.environ.get("GEMMA4_BACKEND", "ollama"),
        help="Inference backend (default: %(default)s)",
    )
    parser.add_argument(
        "--base-url",
        default=os.environ.get("GEMMA4_BASE_URL"),
        help="Override the backend's OpenAI-compatible base URL",
    )
    parser.add_argument(
        "--api-key",
        default=os.environ.get("GEMMA4_API_KEY"),
        help="Override the API key (local defaults are otherwise used)",
    )
    parser.add_argument(
        "--model",
        default=os.environ.get("GEMMA4_MODEL", "gemma4-heretical"),
        help="Model ID sent to the server (default: %(default)s)",
    )
    parser.add_argument(
        "--context",
        type=int,
        default=os.environ.get("GEMMA4_CONTEXT", "16384"),
        metavar="TOKENS",
        help="Context window used for reporting and Ollama requests (default: %(default)s)",
    )
    parser.add_argument(
        "--image",
        action="append",
        default=[],
        metavar="PATH",
        help="Attach a local image to the first user message (repeatable)",
    )
    parser.add_argument("--heartbeat", type=int, default=0, metavar="SECONDS",
                        help="Send a heartbeat every N seconds (0 = disabled)")
    args = parser.parse_args()
    if args.backend not in BACKEND_DEFAULTS:
        parser.error(
            f"invalid backend from GEMMA4_BACKEND: {args.backend!r}; "
            f"choose from {', '.join(sorted(BACKEND_DEFAULTS))}"
        )
    return args

def chat():
    global BACKEND, MODEL, NUM_CTX, client

    args = parse_args()
    if args.context <= 0:
        print("ERROR: --context must be greater than zero.", file=sys.stderr)
        sys.exit(2)
    if args.heartbeat < 0:
        print("ERROR: --heartbeat cannot be negative.", file=sys.stderr)
        sys.exit(2)

    BACKEND = args.backend
    MODEL = args.model
    NUM_CTX = args.context
    backend_defaults = BACKEND_DEFAULTS[BACKEND]
    base_url = args.base_url or backend_defaults["base_url"]
    api_key = args.api_key or backend_defaults["api_key"]
    client = OpenAI(base_url=base_url, api_key=api_key)

    messages = []
    lock = threading.Lock()
    try:
        pending_images = [resolve_image(path) for path in args.image]
    except ValueError as e:
        print(f"ERROR: {e}", file=sys.stderr)
        sys.exit(2)

    # Optional system prompt from file argument (loaded first — highest priority)
    if args.system_file:
        try:
            with open(args.system_file) as f:
                system_content = f.read().strip()
            messages.append({"role": "system", "content": system_content})
            print(f"(system prompt loaded from {args.system_file})\n")
        except OSError as e:
            print(f"ERROR: Could not read {args.system_file}: {e}", file=sys.stderr)
            sys.exit(1)

    # Auto-inject last exchange from previous session
    last_exchange = last_exchange_system_block()
    if last_exchange:
        messages.append({"role": "system", "content": last_exchange})
        print("(previous session context loaded)\n")

    # Auto-inject memories as system context
    memories = load_memories()
    memory_block = memories_as_system_block(memories)
    if memory_block:
        messages.append({"role": "system", "content": memory_block})
        print(f"({len(memories)} memories loaded)\n")

    # Instruct model on memory tool usage
    messages.append({"role": "system", "content": (
        "You have access to memory tools: save_memory, search_memories, and forget_memory. "
        "Use save_memory proactively whenever the user shares something worth remembering across sessions — "
        "preferences, facts about themselves, decisions, or important context. "
        "Use search_memories when you need to recall something that might be stored. "
        "Use search_memories_by_tag to retrieve all memories under a specific topic tag. "
        "Use forget_memory when the user asks you to forget something. "
        "Do not wait to be asked — save things as they come up naturally in conversation."
    )})

    # Inject heartbeat protocol if enabled
    if args.heartbeat > 0:
        hb_system = HEARTBEAT_SYSTEM + f"\n\nHeartbeat interval: every {args.heartbeat} seconds."
        messages.append({"role": "system", "content": hb_system})
        print(f"(heartbeat every {args.heartbeat}s)\n")

    print(f"Chatting with {MODEL} via {BACKEND} ({base_url}).")
    print("Use /image PATH to attach an image, /help for commands, or exit to quit.")
    if pending_images:
        print(f"({len(pending_images)} image(s) queued for the first message)")
    print()
    last_message_time = None
    last_user_message_time = [None]  # mutable container shared with heartbeat thread

    # Start heartbeat thread
    stop_event = threading.Event()
    if args.heartbeat > 0:
        hb_thread = threading.Thread(
            target=heartbeat_worker,
            args=(messages, lock, args.heartbeat, stop_event, last_user_message_time),
            daemon=True,
        )
        hb_thread.start()

    try:
        while True:
            user_input = read_input()
            if user_input is None:
                print()
                break
            if not user_input:
                continue

            # A terminal paste can contain the /image command and its question
            # in one buffered read. Queue from the first line and immediately
            # submit the remaining lines as the message.
            command_input = user_input
            pasted_message = ""
            if user_input.lower().startswith("/image ") and "\n" in user_input:
                command_input, pasted_message = user_input.split("\n", 1)
                pasted_message = pasted_message.strip()
            if handle_local_command(command_input, pending_images):
                if not pasted_message:
                    continue
                user_input = pasted_message

            if user_input.startswith("**sys:"):
                system_content = user_input[len("**sys:"):].strip()
                with lock:
                    messages.append({"role": "system", "content": system_content})
                print("(added to system context)\n")
                continue

            enveloped = wrap_with_envelope(user_input, last_message_time)
            last_message_time = datetime.datetime.now()
            last_user_message_time[0] = last_message_time

            attached_images = list(pending_images)
            saved_message = enveloped
            if attached_images:
                names = ", ".join(Path(path).name for path in attached_images)
                saved_message += f"\n[Attached images: {names}]"
            write_file(LAST_MESSAGE_PATH, saved_message)
            with lock:
                messages.append({
                    "role": "user",
                    "content": user_message_content(enveloped, attached_images),
                })
                reply, usage = do_api_call(messages)
                messages.append({"role": "assistant", "content": reply})
            pending_images.clear()
            write_file(LAST_RESPONSE_PATH, reply)

            if usage:
                pct = int(usage.prompt_tokens / NUM_CTX * 100)
                print(f"\n{reply} [{pct}%]\n")
            else:
                print(f"\n{reply}\n")
    finally:
        stop_event.set()

if __name__ == "__main__":
    chat()
